# ─── Supabase Configuration ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_ANON_KEY=your_supabase_anon_key
# Supabase Service Role Key (server-side only, bypasses RLS for admin leads management)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Admin Authentication ───
# Email used to log into /admin/login
ADMIN_EMAIL=admin@ethixweb.com
# Option A (simplest for Vercel): Plain password
ADMIN_PASSWORD=admin123
# Option B (recommended for production): Bcrypt hash of admin password
ADMIN_PASSWORD_HASH=$2b$10$Ok/cJLOL4yHfX4dNSZrX3O6wenTsXWj.QkPjbsnxz07jIm/Hau5MO

# ─── Session Secret ───
# Random 64+ char hex string for signing HMAC session tokens
AUTH_SECRET=generate_a_random_64_char_string

# ─── Site & Origin URLs ───
# Set to your production domain or local dev URL (e.g. http://localhost:3000 or http://localhost:3001)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Commands to generate secrets ───
# Generate ADMIN_PASSWORD_HASH:
# node -e "const bcrypt = require('bcryptjs'); console.log(bcrypt.hashSync('your_password', 10))"
#
# Generate AUTH_SECRET:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
